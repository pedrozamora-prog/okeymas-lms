generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  BRANCH_ADMIN
  MANAGER
  INSTRUCTOR
  EMPLOYEE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReportFrequency {
  DISABLED
  WEEKLY
  MONTHLY
}

enum LessonType {
  VIDEO
  PDF
  QUIZ
  LIVE_CLASS
  SCORM
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

enum CertificateType {
  COMPLETION
  PROFESSIONAL
}

enum NotificationType {
  NEW_ENROLLMENT
  DEADLINE_REMINDER
  CERTIFICATE_EXPIRY
  MANDATORY_OVERDUE
  COURSE_COMPLETED
  NEW_COMMENT
}

enum SurveyQuestionType {
  NPS
  RATING
  TEXT
  CHOICE
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  CHAIN
  ENTERPRISE
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ORDER_ITEMS
  FILL_BLANK
  FREE_TEXT
  IMAGE_CHOICE
}

enum WebhookEvent {
  COURSE_COMPLETED
  CERTIFICATE_ISSUED
  USER_CREATED
  ENROLLMENT_CREATED
}

enum AuditAction {
  USER_LOGIN
  USER_LOGOUT
  USER_CREATED
  USER_UPDATED
  USER_DEACTIVATED
  USER_DELETED
  USER_PASSWORD_RESET
  COURSE_CREATED
  COURSE_UPDATED
  COURSE_PUBLISHED
  COURSE_ARCHIVED
  COURSE_DELETED
  ENROLLMENT_CREATED
  ENROLLMENT_COMPLETED
  ENROLLMENT_EXPIRED
  CERTIFICATE_ISSUED
  QUIZ_PASSED
  QUIZ_FAILED
  SETTINGS_UPDATED
  REPORT_EXPORTED
  INVITATION_SENT
  API_KEY_GENERATED
  ROLE_CHANGED
}

enum Department {
  ADMINISTRACION
  RECEPCION
  LIMPIEZA
  MONITOR
  DEPORTIVO
}

// ─── ORGANIZATION (SUCURSAL / GYM) ───────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Plan SaaS
  plan           OrgPlan  @default(STARTER)
  maxUsers       Int      @default(50)
  planExpiresAt  DateTime?
  trialEndsAt    DateTime?

  // White label
  primaryColor   String?
  customLogoUrl  String?

  // API pública
  apiKey         String?  @unique

  // Configuración de notificaciones por email
  notifyNewEnrollment Boolean @default(true)
  notifyDeadline7d    Boolean @default(true)
  notifyDeadline3d    Boolean @default(true)
  notifyDeadline1d    Boolean @default(true)
  notifyOverdue       Boolean @default(true)

  // Integración de email (por organización)
  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?
  resendApiKey     String?

  // Onboarding
  onboardedAt      DateTime?

  // Informes programados
  reportFrequency  ReportFrequency @default(DISABLED)
  reportDayOfWeek  Int             @default(1)  // 1=lunes … 7=domingo
  reportDayOfMonth Int             @default(1)  // 1-31
  reportLastSentAt DateTime?

  // WhatsApp (Tier 2 — preparado en schema)
  whatsappEnabled        Boolean @default(false)
  twilioAccountSid       String?
  twilioAuthToken        String?
  twilioWhatsappFrom     String?
  notifyWhatsappDeadline Boolean @default(true)
  notifyWhatsappEnroll   Boolean @default(true)

  users           User[]
  courses         Course[]
  liveClasses     LiveClass[]
  enrollmentRules EnrollmentRule[]
  webhooks        Webhook[]
  invitations     Invitation[]
  competencies    Competency[]
  jobRoles        JobRole[]
  auditLogs       AuditLog[]
  learningPaths   LearningPath[]
  ssoConfig       OrgSsoConfig?

  @@map("organizations")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  emailVerified  DateTime?
  hashedPassword String?
  image          String?
  role           Role       @default(EMPLOYEE)
  department     Department?
  phone           String?
  locale          String     @default("es")
  whatsappPhone   String?
  whatsappEnabled Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  accounts        Account[]
  sessions        Session[]
  enrollments     Enrollment[]
  progress        LessonProgress[]
  instructing     LiveClass[]      @relation("LiveClassInstructor")
  attendance      LiveAttendance[]
  points          UserPoints?
  badges          UserBadge[]
  certificates    Certificate[]
  notifications   Notification[]
  lessonComments  LessonComment[]
  surveyResponses SurveyResponse[]
  sentInvitations    Invitation[]          @relation("InvitedBy")
  quizAttempts       QuizAttempt[]
  watchSessions      VideoWatchSession[]
  interactiveAnswers InteractiveAnswer[]
  jobRoles           UserJobRole[]
  auditLogs          AuditLog[]
  courseSignatures   CourseSignature[]

  @@map("users")
}

// ─── INVITATIONS ─────────────────────────────────────────────────────────────

model Invitation {
  id             String      @id @default(cuid())
  email          String
  token          String      @unique @default(cuid())
  role           Role        @default(EMPLOYEE)
  department     Department?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  invitedById    String
  invitedBy      User         @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@unique([email, organizationId])
  @@map("invitations")
}

// ─── AUTH (NextAuth) ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── COURSE ──────────────────────────────────────────────────────────────────

model Course {
  id              String       @id @default(cuid())
  title           String
  description     String?
  thumbnailUrl    String?
  status          CourseStatus @default(DRAFT)
  departments     Department[]
  isRequired      Boolean      @default(false)
  daysToComplete  Int?
  order           Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  certificateEnabled      Boolean         @default(false)
  certificateType         CertificateType @default(COMPLETION)
  certificateValidityDays Int?
  certSignerName          String?
  certSignerTitle         String?

  signatureEnabled Boolean @default(false)

  // Marketplace
  isMarketplace        Boolean @default(false)
  marketplaceCategory  String?
  marketplaceShortDesc String?
  importedFromId       String? // original marketplace courseId if this is a clone

  modules          Module[]
  enrollments      Enrollment[]
  paths            LearningPathCourse[]
  certificates     Certificate[]
  enrollmentRules  EnrollmentRule[]
  survey           CourseSurvey?
  competencies     CourseCompetency[]
  signatures       CourseSignature[]

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  lessons Lesson[]

  @@map("modules")
}

model Lesson {
  id          String     @id @default(cuid())
  title       String
  description String?
  type        LessonType
  videoUrl    String?
  fileUrl     String?
  duration    Int?
  order       Int        @default(0)
  isRequired  Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  quiz              Quiz?
  liveClass         LiveClass?
  progress          LessonProgress[]
  comments          LessonComment[]
  watchSessions     VideoWatchSession[]
  interactivePoints InteractivePoint[]

  @@map("lessons")
}

// ─── QUIZ ────────────────────────────────────────────────────────────────────

model Quiz {
  id              String   @id @default(cuid())
  passingScore    Int      @default(70)
  maxAttempts     Int      @default(3)
  timeLimitMins   Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessonId String @unique
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model QuizAttempt {
  id        String   @id @default(cuid())
  score     Int                          // 0-100 porcentaje
  passed    Boolean
  answers   Json                         // [{questionId, selectedOptionId}]
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

model QuizQuestion {
  id          String           @id @default(cuid())
  text        String
  type        QuizQuestionType @default(MULTIPLE_CHOICE)
  imageUrl    String?
  modelAnswer String?
  explanation String?
  order       Int              @default(0)
  createdAt   DateTime         @default(now())

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  options QuizOption[]

  @@map("quiz_questions")
}

model QuizOption {
  id        String  @id @default(cuid())
  text      String
  isCorrect Boolean @default(false)
  order     Int     @default(0)

  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_options")
}

// ─── ENROLLMENT & PROGRESS ───────────────────────────────────────────────────

model Enrollment {
  id          String           @id @default(cuid())
  status      EnrollmentStatus @default(ENROLLED)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  deadline    DateTime?
  score       Int?
  autoEnrolled Boolean         @default(false)

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(cuid())
  completed   Boolean   @default(false)
  score       Int?
  attempts    Int       @default(0)
  timeSpent   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

// ─── LIVE CLASSES ────────────────────────────────────────────────────────────

model LiveClass {
  id           String    @id @default(cuid())
  title        String
  scheduledAt  DateTime
  durationMins Int       @default(60)
  roomUrl      String?
  recordingUrl String?
  isRecurring  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  instructorId   String
  instructor     User         @relation("LiveClassInstructor", fields: [instructorId], references: [id])
  lessonId       String?      @unique
  lesson         Lesson?      @relation(fields: [lessonId], references: [id])

  attendance LiveAttendance[]

  @@map("live_classes")
}

model LiveAttendance {
  id         String    @id @default(cuid())
  joinedAt   DateTime  @default(now())
  leftAt     DateTime?
  durationS  Int?

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)

  @@unique([userId, liveClassId])
  @@map("live_attendance")
}

// ─── LEARNING PATHS ──────────────────────────────────────────────────────────

model LearningPath {
  id             String   @id @default(cuid())
  title          String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  courses LearningPathCourse[]

  @@map("learning_paths")
}

model LearningPathCourse {
  order      Int     @default(0)
  onFailGoTo String? // courseId within same path — redirect here when quiz fails

  pathId   String
  path     LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId String
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([pathId, courseId])
  @@map("learning_path_courses")
}

// ─── GAMIFICATION ────────────────────────────────────────────────────────────

model UserPoints {
  id        String   @id @default(cuid())
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_points")
}

model Badge {
  id          String  @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  points      Int     @default(0)

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  earnedAt DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

// ─── CERTIFICATES ────────────────────────────────────────────────────────────

// ─── ENROLLMENT RULES ────────────────────────────────────────────────────────

model EnrollmentRule {
  id             String      @id @default(cuid())
  triggerRole    Role?
  triggerDept    Department?
  daysToComplete Int?
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("enrollment_rules")
}

// ─── NOTIFICATIONS ────────────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  sentEmail Boolean          @default(false)
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── CERTIFICATES ────────────────────────────────────────────────────────────

model Certificate {
  id          String          @id @default(cuid())
  courseTitle String
  type        CertificateType @default(COMPLETION)
  issuedAt    DateTime        @default(now())
  expiresAt   DateTime?
  fileUrl     String?

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String?
  course   Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@map("certificates")
}

// ─── WEBHOOKS ────────────────────────────────────────────────────────────────

model Webhook {
  id        String         @id @default(cuid())
  url       String
  events    WebhookEvent[]
  isActive  Boolean        @default(true)
  secret    String?
  createdAt DateTime       @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// ─── FOROS (LESSON COMMENTS) ─────────────────────────────────────────────────

model LessonComment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   LessonComment?  @relation("replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  LessonComment[] @relation("replies")

  @@map("lesson_comments")
}

// ─── ENCUESTAS POST-CURSO ─────────────────────────────────────────────────────

model CourseSurvey {
  id        String   @id @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  courseId  String @unique
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  questions SurveyQuestion[]
  responses SurveyResponse[]

  @@map("course_surveys")
}

model SurveyQuestion {
  id      String             @id @default(cuid())
  text    String
  type    SurveyQuestionType @default(TEXT)
  options String[]
  order   Int                @default(0)

  surveyId String
  survey   CourseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@map("survey_questions")
}

model SurveyResponse {
  id        String   @id @default(cuid())
  answers   Json
  createdAt DateTime @default(now())

  surveyId String
  survey   CourseSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([surveyId, userId])
  @@map("survey_responses")
}

// ─── VIDEO ANALYTICS (TIER 1) ────────────────────────────────────────────────

model VideoWatchSession {
  id              String   @id @default(cuid())
  watchedSegments Json     @default("[]") // [[start,end], ...] en segundos
  totalWatchTime  Int      @default(0)    // segundos totales únicos vistos
  maxProgress     Float    @default(0)    // 0-100 punto más lejano alcanzado
  rewatchCount    Int      @default(0)    // nº de veces que retrocedió
  playbackSpeeds  Json     @default("[]") // [1, 1.5, 2] velocidades usadas
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@index([lessonId])
  @@map("video_watch_sessions")
}

// ─── VIDEO INTERACTIVO (TIER 1) ───────────────────────────────────────────────

model InteractivePoint {
  id        String   @id @default(cuid())
  timestamp Int      // segundos desde el inicio del vídeo
  question  String
  options   Json     // [{id, text, isCorrect: boolean}]
  canSkip   Boolean  @default(false)
  skipAfter Int?     // segundos para auto-skip (null = obligatorio responder)
  createdAt DateTime @default(now())

  lessonId String
  lesson   Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers  InteractiveAnswer[]

  @@unique([lessonId, timestamp])
  @@index([lessonId])
  @@map("interactive_points")
}

model InteractiveAnswer {
  id               String   @id @default(cuid())
  selectedOptionId String
  correct          Boolean
  answeredAt       DateTime @default(now())

  interactivePointId String
  interactivePoint   InteractivePoint @relation(fields: [interactivePointId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([interactivePointId, userId])
  @@map("interactive_answers")
}

// ─── COMPETENCIAS Y PUESTOS (TIER 1) ─────────────────────────────────────────

model Competency {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobRoles       RoleCompetency[]
  courses        CourseCompetency[]

  @@unique([organizationId, name])
  @@map("competencies")
}

model JobRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  competencies   RoleCompetency[]
  users          UserJobRole[]

  @@unique([organizationId, name])
  @@map("job_roles")
}

model RoleCompetency {
  required Boolean @default(true)

  jobRoleId    String
  jobRole      JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([jobRoleId, competencyId])
  @@map("role_competencies")
}

model CourseCompetency {
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  competencyId String
  competency   Competency @relation(fields: [competencyId], references: [id], onDelete: Cascade)

  @@id([courseId, competencyId])
  @@map("course_competencies")
}

model UserJobRole {
  assignedAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobRoleId String
  jobRole   JobRole @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)

  @@id([userId, jobRoleId])
  @@map("user_job_roles")
}

// ─── SSO / SAML 2.0 ──────────────────────────────────────────────────────────

model OrgSsoConfig {
  id             String   @id @default(cuid())
  isEnabled      Boolean  @default(false)
  idpEntityId    String
  idpSsoUrl      String
  idpCertificate String   // PEM public cert (no headers needed)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String       @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("org_sso_configs")
}

model SsoToken {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime

  @@map("sso_tokens")
}

// ─── FIRMA DIGITAL ───────────────────────────────────────────────────────────

model CourseSignature {
  id            String   @id @default(cuid())
  signatureData String   // base64 PNG del trazo del canvas
  ipAddress     String?
  userAgent     String?
  signedAt      DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_signatures")
}

// ─── AUDIT LOGS ──────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  action    AuditAction
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
